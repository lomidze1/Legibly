# Legibly API — copy to .env.local for development, set the real values in Vercel.
# NEVER commit filled-in values.

# --- core (required) ---
NODE_ENV=development
API_PUBLIC_URL=https://api.legibly.design
WEBSITE_BASE_URL=https://legibly.design
AUTH_SECRET=              # >= 32 chars — openssl rand -base64 32
ADMIN_TOKEN=              # >= 32 chars — openssl rand -base64 32
                          # opens /api/admin/panel#token=<ADMIN_TOKEN> — see docs/admin-panel.md
DATABASE_URL=             # Postgres connection string

# --- Figma OAuth (Phase 2) ---
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_REDIRECT_URI=https://api.legibly.design/api/auth/figma/callback

# --- Flitt (Phase 3) ---
FLITT_MERCHANT_ID=
FLITT_SECRET_KEY=
FLITT_BASE_URL=https://pay.flitt.com
FLITT_WEBHOOK_IPS=54.154.216.60,3.75.125.89
FLITT_IP_ALLOWLIST_ENABLED=true

# --- AI Designer Judge (Phase 4) ---
# OFF until the rubric eval passes — see docs/judge-eval.md (D24).
JUDGE_ENABLED=false
ANTHROPIC_API_KEY=
JUDGE_MODEL=              # blank = claude-opus-5
JUDGE_FREE_TRIALS=3       # lifetime, per free user
JUDGE_PRO_MONTHLY=30      # per month, per Pro licence — this is a cost cap, see config/judge.ts
