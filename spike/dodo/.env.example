# Dodo dashboard → Developer → API Keys (test mode)
DODO_PAYMENTS_API_KEY=

# Dodo dashboard → Webhooks → the endpoint's signing secret (starts with whsec_)
DODO_PAYMENTS_WEBHOOK_KEY=

# The subscription product you create in the dashboard, priced $12/month
DODO_PRODUCT_ID=

# Where Dodo sends the buyer back after checkout
RETURN_URL=http://localhost:4242/checkout/success
